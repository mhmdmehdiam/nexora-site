# ===== Nexora — Environment Variables =====
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ================================================================
# PostgreSQL — production checklist
# ================================================================
# 1. Create a PostgreSQL database (Supabase, Neon, Railway, AWS RDS)
# 2. Run: npx prisma migrate deploy
# 3. Set DATABASE_URL (direct) and DATABASE_POOL_URL (PgBouncer)
# ================================================================

# Direct connection — for Prisma migrations, db push, and Studio only.
# Must have ?schema=public for PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Pooled connection — what the app uses at runtime.
# Use PgBouncer or your provider's pooler in TRANSACTION mode.
# Without a pooler, each Next.js instance opens up to 20 connections.
DATABASE_POOL_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/DB?schema=public"

# ================================================================
# Auth — generate a strong secret (≥ 32 chars)
# ================================================================
JWT_SECRET="change-this-to-a-random-string-min-32-chars-long"

# ================================================================
# ZarinPal — Iranian payment gateway
# ================================================================
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="1"
PUBLIC_BASE_URL="https://your-domain.com"
# Secret for the payment-reconciliation cron job:
#   curl -X POST https://your-domain.com/api/billing/reconcile -H "x-cron-secret: $CRON_SECRET"
CRON_SECRET="generate-a-random-string-here"

# ================================================================
# SMS — leave empty to run in mock mode (message stored, marked sent)
# ================================================================
# SMS_PROVIDER="kavenegar"   # or "smsir"
# KAVENEGAR_API_KEY=""
# KAVENEGAR_SENDER="10004346"
# SMSIR_API_KEY=""
# SMSIR_LINE_NUMBER="30007732"

# ================================================================
# AI insights — leave empty to use the built-in rule-based analysis
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq, DeepSeek)
# ================================================================
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"

# ================================================================
# Observability — all optional; JSON logs to stdout always work
# ================================================================
# SENTRY_DSN="https://<public-key>@o<org>.ingest.sentry.io/<project-id>"
# LOGTAIL_TOKEN=""

# ================================================================
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# ================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/auth/google/callback"

# ================================================================
# Canonical public origin — metadata, sitemap, robots, OG tags
# ================================================================
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
PUBLIC_BASE_URL="https://your-domain.com"

# ================================================================
# Email (SMTP) — password reset, contact form
# Empty SMTP_HOST = mock mode (logged, never sent)
# ================================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="نکسورا <no-reply@your-domain.com>"
CONTACT_INBOX="support@your-domain.com"

# Platform admin password when seeding production
SEED_ADMIN_PASSWORD=""
