[Unit]
Description=Nexora — Next.js cluster (4 workers + reverse proxy)
Documentation=https://github.com/your-org/nexora
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nexora
Group=nexora
WorkingDirectory=/var/www/nexora

# The cluster script spawns 4 Next.js workers on 3101–3104 and a
# round-robin proxy on 3100. nginx talks to 3100.
ExecStart=/usr/bin/node scripts/cluster-server.cjs 4

# Load environment (DATABASE_URL, JWT_SECRET, …)
EnvironmentFile=/var/www/nexora/.env
Environment=NODE_ENV=production

# --- resilience ---
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

# --- resource limits ---
LimitNOFILE=65535
MemoryMax=3G

# --- logging → journald (view with: journalctl -u nexora -f) ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexora

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/nexora/backups /var/www/nexora/.pm2

[Install]
WantedBy=multi-user.target
